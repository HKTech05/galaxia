  photoUrl         String?       @map("photo_url")
  checkoutPhotoUrl String?       @map("checkout_photo_url")
  inTime           DateTime?     @map("in_time")
  outTime          DateTime?     @map("out_time")
  inTimeMarkedBy   String?       @map("in_time_marked_by")
  outTimeMarkedBy  String?       @map("out_time_marked_by")
  markedAt         DateTime      @default(now()) @map("marked_at")
  markedBy         String?       @map("marked_by")

