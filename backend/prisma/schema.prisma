model SecurityStaff {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  role            String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  photoUrl        String?  @map("photo_url")
  isActive        Boolean  @default(true) @map("is_active")
  dutyTime        String?  @map("duty_time") @db.VarChar(10)
  dutyEndTime     String?  @map("duty_end_time") @db.VarChar(10)
  monthlySalary   Int?     @map("monthly_salary")
  salaryReduction Int?     @map("salary_reduction")
  allowedHolidays Int?     @map("allowed_holidays")
